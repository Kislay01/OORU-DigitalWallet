ENVIRONMENT=development

# Database (SQLite for quick local runs, PostgreSQL via docker compose)
DATABASE_URL=sqlite+aiosqlite:///./wallet.db
POSTGRES_USER=wallet
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wallet

# Portal login tokens
SECRET_KEY=change_me_to_a_random_value_of_at_least_32_chars
TOKEN_TTL_SECONDS=3600

# Seed accounts (replace for any shared deployment)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_VERIFIER_USERNAME=verifier
SEED_VERIFIER_PASSWORD=verifier123

# Public URL the wallet and verifier use to reach this backend
PUBLIC_BASE_URL=http://localhost:8000

# Where the issuer signing key is kept
KEY_DIR=./keys
